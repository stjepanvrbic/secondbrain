#!/usr/bin/env bash
#
# pre-push: refuse to push unless the plugin is validation-clean.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PLUGIN_ROOT="$REPO_ROOT/secondbrain"
BUMP_SCRIPT="$PLUGIN_ROOT/scripts/bump_version.py"
TESTS_DIR="$REPO_ROOT/tests"

red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green() { printf '\033[32m%s\033[0m\n' "$*" >&2; }
bold()  { printf '\033[1m%s\033[0m\n' "$*" >&2; }

fail() {
    red "pre-push BLOCKED: $1"
    if [ $# -ge 2 ]; then
        shift
        for line in "$@"; do
            red "    $line"
        done
    fi
    exit 1
}

command -v python3 >/dev/null 2>&1 || fail "python3 not on PATH"
PYTEST_BIN="$(command -v pytest || true)"
[ -n "$PYTEST_BIN" ] || fail "pytest not on PATH" "Activate the project environment that provides pytest and retry."

bold "pre-push: validation gate starting"

bold "pre-push: [1/4] version consistency check"
if ! python3 "$BUMP_SCRIPT" --check; then
    fail "version files are inconsistent" "Fix with:" "    python3 secondbrain/scripts/bump_version.py <version>" "    git add .claude-plugin/marketplace.json secondbrain/.claude-plugin/plugin.json secondbrain/.claude-plugin/release.json secondbrain/skills/*/SKILL.md" "    git commit"
fi

bold "pre-push: [2/4] plugin manifest tests"
if ! "$PYTEST_BIN" "$TESTS_DIR/test_plugin_manifest.py" -q --no-header; then
    fail "plugin manifest tests failed — the plugin would ship broken" "Fix the failures above, then push again."
fi

bold "pre-push: [3/4] distribution validation"
if ! python3 "$PLUGIN_ROOT/scripts/validate_distribution.py" --claude-smoke; then
    fail "distribution validation failed — marketplace/install or release ZIP is broken" "Fix the validation errors above, then push again."
fi

bold "pre-push: [4/4] full pytest suite"
if ! "$PYTEST_BIN" "$TESTS_DIR" -q --no-header; then
    fail "tests failed — refusing to push"
fi

green "pre-push: all validation checks passed — push allowed"
exit 0
