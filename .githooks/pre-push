#!/usr/bin/env bash
#
# pre-push: refuse to push unless the plugin is in a perfectly healthy state.
#
# This hook is TRACKED in the repo (.githooks/pre-push) and activated by running
# `python3 secondbrain/scripts/install_git_hooks.py` which sets
# `core.hooksPath = .githooks`. If you see this hook not running, core.hooksPath
# is probably not set for your clone.
#
# What this hook enforces:
#   1. version drift        — plugin.json / marketplace.json metadata.version / plugins[].version / SKILL.md all in lockstep
#   2. auto version bump    — if version == last tag (no manual bump), auto-bump patch + commit + tag
#   3. auto tag creation    — if version > last tag but no tag, auto-create tag
#   4. manifest health      — test_plugin_manifest.py must pass
#   5. full test suite      — all tests must pass
#
# AUTO-REMEDIATION: Gates 2-3 auto-fix missing bumps/tags by running
# bump_version.py --release, then abort so `git push` can be re-run with
# the new commit + tag included. This means `git push` is the ONLY command
# the developer needs. If it aborts, just run `git push` again.
#
# What this hook must NOT do:
#   - NEVER `git commit --amend` during push. The old hook did that, which caused
#     a non-fast-forward push, which caused a force-push, which wedged every
#     shallow marketplace clone downstream.
#   - NEVER pass `--no-verify` in any nested git call.
#   - NEVER skip tests under time pressure.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PLUGIN_ROOT="$REPO_ROOT/secondbrain"
BUMP_SCRIPT="$PLUGIN_ROOT/scripts/bump_version.py"
TESTS_DIR="$REPO_ROOT/tests"

red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green() { printf '\033[32m%s\033[0m\n' "$*" >&2; }
bold()  { printf '\033[1m%s\033[0m\n' "$*" >&2; }

fail() {
    red "pre-push BLOCKED: $1"
    if [ $# -ge 2 ]; then
        shift
        for line in "$@"; do
            red "    $line"
        done
    fi
    exit 1
}

bold "pre-push: full health check starting"

# -------------------------------------------------------------------------
# 0. Sanity: must have python3 and pytest
# -------------------------------------------------------------------------
command -v python3 >/dev/null 2>&1 || fail "python3 not on PATH"
python3 -c "import pytest" 2>/dev/null || fail "pytest not installed" \
    "Install with: pip install pytest pytest-mock"

# -------------------------------------------------------------------------
# 1. Version consistency across all files
# -------------------------------------------------------------------------
bold "pre-push: [1/5] version consistency check"
if ! python3 "$BUMP_SCRIPT" --check; then
    fail "version files are inconsistent" \
        "Fix with:" \
        "    python3 secondbrain/scripts/bump_version.py <new-version>" \
        "    git add -u && git commit --amend --no-edit" \
        "    git push"
fi

# -------------------------------------------------------------------------
# 2-3. Auto-bump and auto-tag: ensure a tagged release exists
# -------------------------------------------------------------------------
bold "pre-push: [2/5] version & tag check"
CURRENT_VERSION=$(python3 -c 'import json,sys; print(json.load(open("'"$PLUGIN_ROOT"'/.claude-plugin/plugin.json"))["version"])')
EXPECTED_TAG="v$CURRENT_VERSION"
LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || true)

# Determine if we need to auto-remediate
NEEDS_BUMP=false
NEEDS_TAG=false

if [ -n "$LAST_TAG" ]; then
    TAG_CLEAN="${LAST_TAG#v}"

    # Case 1: version == last tag → no manual bump was done, auto-bump needed
    if [ "$CURRENT_VERSION" = "$TAG_CLEAN" ]; then
        NEEDS_BUMP=true
    fi
fi

# Case 2: version has no matching tag → tag needed
if ! git tag -l "$EXPECTED_TAG" | grep -q .; then
    NEEDS_TAG=true
fi

# Case 3: tag exists but not reachable from HEAD → stale tag, re-tag needed
if [ "$NEEDS_TAG" = "false" ]; then
    TAG_COMMIT=$(git rev-list -n 1 "$EXPECTED_TAG")
    if ! git merge-base --is-ancestor "$TAG_COMMIT" HEAD 2>/dev/null; then
        bold "pre-push: tag $EXPECTED_TAG is stale (not reachable from HEAD), deleting"
        git tag -d "$EXPECTED_TAG" >/dev/null 2>&1
        NEEDS_TAG=true
    fi
fi

# Auto-remediate: bump + tag, or just tag
if [ "$NEEDS_BUMP" = "true" ]; then
    bold "pre-push: auto-bumping patch version (current $CURRENT_VERSION == last tag $LAST_TAG)"
    python3 "$BUMP_SCRIPT" --release
    NEW_VERSION=$(python3 -c 'import json,sys; print(json.load(open("'"$PLUGIN_ROOT"'/.claude-plugin/plugin.json"))["version"])')
    bold ""
    bold "pre-push: auto-bumped $CURRENT_VERSION -> $NEW_VERSION and tagged v$NEW_VERSION"
    bold "pre-push: run 'git push' again to include the version bump"
    exit 1
elif [ "$NEEDS_TAG" = "true" ]; then
    bold "pre-push: auto-creating tag $EXPECTED_TAG for current version"
    python3 "$BUMP_SCRIPT" --tag
    bold ""
    bold "pre-push: created tag $EXPECTED_TAG"
    bold "pre-push: run 'git push' again to include the tag"
    exit 1
else
    green "pre-push: version $CURRENT_VERSION has matching tag $EXPECTED_TAG"
fi

# -------------------------------------------------------------------------
# 4. Full plugin-manifest health check
# -------------------------------------------------------------------------
bold "pre-push: [4/5] test_plugin_manifest.py (plugin structure health)"
if ! python3 -m pytest "$TESTS_DIR/test_plugin_manifest.py" -q --no-header; then
    fail "plugin manifest tests failed — the plugin would ship broken" \
        "Fix the failures above, then push again."
fi

# -------------------------------------------------------------------------
# 5. Full test suite
# -------------------------------------------------------------------------
bold "pre-push: [5/5] full pytest suite"
if ! python3 -m pytest "$TESTS_DIR" -q --no-header; then
    fail "tests failed — refusing to push"
fi

green "pre-push: all checks passed — push allowed"
exit 0
