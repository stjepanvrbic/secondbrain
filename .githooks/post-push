#!/usr/bin/env bash
#
# post-push: create a GitHub release and demote old releases.
#
# Spawned as a background process by pre-push. Polls for the tag on the
# remote, creates a release marked as "Latest", then demotes all older
# releases so /releases/latest always returns only the newest version.
# Release history is preserved — nothing is deleted.
#
# Requirements: `gh` CLI authenticated. If `gh` is not on PATH, exits
# quietly — the push already succeeded, the release is a nice-to-have.

set -euo pipefail

TAG="${1:-}"
if [ -z "$TAG" ]; then
    exit 0
fi

# gh must be available
if ! command -v gh >/dev/null 2>&1; then
    exit 0
fi

# Poll for the tag on the remote (max 60s, check every 3s)
LANDED=false
for _ in $(seq 1 20); do
    sleep 3
    if gh api "repos/{owner}/{repo}/git/refs/tags/$TAG" >/dev/null 2>&1; then
        LANDED=true
        break
    fi
done

if [ "$LANDED" != "true" ]; then
    exit 0
fi

# Create the new release, explicitly marked as Latest
gh release create "$TAG" --generate-notes --title "$TAG" --latest 2>/dev/null || true

# Demote all older releases so only the new one is "Latest".
# This preserves release history while ensuring /releases/latest
# returns only the newest version.
gh release list --json tagName --jq '.[].tagName' 2>/dev/null | while read -r OLD_TAG; do
    if [ "$OLD_TAG" != "$TAG" ]; then
        gh release edit "$OLD_TAG" --latest=false 2>/dev/null || true
    fi
done

# Delete old tags from remote. Cowork's marketplace uses tags to detect
# versions — multiple tags cause it to step through each one instead of
# jumping to latest. Keep only the current tag.
for OLD_TAG in $(git ls-remote --tags origin 2>/dev/null | sed 's/.*refs\/tags\///' | grep -v '\^{}'); do
    if [ "$OLD_TAG" != "$TAG" ]; then
        git push origin --delete "refs/tags/$OLD_TAG" 2>/dev/null || true
    fi
done

exit 0
