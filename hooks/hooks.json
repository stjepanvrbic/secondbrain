{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "prompt",
          "prompt": "Run /secondbrain:session-start"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "prompt",
          "prompt": "Run /secondbrain:session-end"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "mcp__obsidian__vault_(create|update|patch|edit)",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-after-write.sh",
          "timeout": 30
        }
      ]
    }
  ]
}
